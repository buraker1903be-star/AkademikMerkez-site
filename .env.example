# --- Supabase (talep formu) ---
# İletişim/talep formu bu iki değerle Supabase'e yazar (lib/submit-lead.ts).
# Tarayıcıya açılırlar; güvenlik RLS politikalarından gelir.
# Eksiklerse form "Site yapılandırması eksik" hatası verir.
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Talebin hangi kuruma yazılacağı. Boş bırakılırsa "akademikmerkez".
NEXT_PUBLIC_ORG_SLUG=akademikmerkez

# --- Panel adresi ---
# Sitedeki "Giriş" bağlantılarının hedefi (lib/site.ts).
# Boş bırakılırsa https://app.akademikmerkez.com.
NEXT_PUBLIC_APP_URL=

# --- Ticari kimlik (isteğe bağlı) ---
# Ticari unvan bilinçli olarak kaynak kodda tutulmuyor. Bu iki değer
# tanımlanınca alt bilgi, KVKK metni ve yapısal veri otomatik güncellenir;
# boş bırakılırsa unvan hiç gösterilmez (lib/site.ts showLegalName).
SITE_LEGAL_NAME=
SITE_MERSIS_NO=
